# Backend Environment Configuration Template

# Database URL (SQLite fallback for local, PostgreSQL for Supabase in production)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# JWT Secret Key for Authentication
JWT_SECRET=findback_secret_key_prod_2026_change_this_secret

# CORS Allowed Origins (Comma separated URLs)
CORS_ORIGINS=https://find-back-ai.vercel.app,http://localhost:5173,http://localhost:5174

# Supabase Storage Credentials (Optional)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_STORAGE_BUCKET=person-photos

# LLM API Config (Optional)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
